<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Internet permission para sa API calls at Render backend -->
    <uses-permission android:name="android.permission.INTERNET"/>
    
    <!-- Camera permissions para sa QR Code scanning -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="true" />

    <!-- Storage permissions para sa pag-download o pag-save ng PDF reports/resibo (Android 12 pababa) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <!-- Bluetooth permissions para sa Bluetooth Thermal Ticket/Receipt Printing (Android 12 pababa) -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Bluetooth permissions para sa modernong Android phones (Android 13 pataas) -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
</manifest>